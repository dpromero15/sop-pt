# Local development — copy to .env.local
# Production Hosting build — see .env.firebase.example → .env.firebase

# SPA (Vite)
# Required for login-anywhere sync. Production Hosting: set GitHub secret VITE_API_BASE_URL
# to the Cloud Run URL from `npm run deploy:api`.
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Shown on the sign-in gate; must match an email in ADMIN_EMAIL_ALLOWLIST
VITE_INITIAL_ADMIN_EMAIL=dromero@sop-network.com

# Local QA ONLY — never set these in .env.firebase, CI, or production Hosting secrets.
# Requires `npm run dev` (import.meta.env.DEV). Production builds ignore / strip this UI.
# VITE_DEV_SIMULATE_AUTH=true
# VITE_DEV_SIMULATE_EMAIL=admin@example.com
# VITE_DEV_SIMULATE_NAME=Dev Coach
# Landing then offers: System Admin (mock teams) + coach with empty roster.

# API (services/api)
PORT=8080
CORS_ORIGIN=http://localhost:3000
# Comma-separated Google emails that become System Admin on first sign-in
ADMIN_EMAIL_ALLOWLIST=dromero@sop-network.com
GOOGLE_CLOUD_PROJECT=
# Or paste a service account JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON=
