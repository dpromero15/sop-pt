# Local development — copy to .env.local
# Production Hosting build — see .env.firebase.example → .env.firebase

# SPA (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Shown on the sign-in gate; must match an email in ADMIN_EMAIL_ALLOWLIST
VITE_INITIAL_ADMIN_EMAIL=admin@example.com

# API (services/api)
PORT=8080
CORS_ORIGIN=http://localhost:3000
# Comma-separated Google emails that become System Admin on first sign-in
ADMIN_EMAIL_ALLOWLIST=admin@example.com
GOOGLE_CLOUD_PROJECT=
# Or paste a service account JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON=
