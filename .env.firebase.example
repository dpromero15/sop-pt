# Production / Firebase Hosting + Cloud Run
# Copy to .env.firebase and fill in values.
# Build SPA: npm run build:firebase
#
# Do NOT add VITE_DEV_SIMULATE_AUTH (or other VITE_DEV_*) here — local QA only via .env.local + npm run dev.

# SPA (baked into dist/ at build time)
VITE_API_BASE_URL=https://sop-pt-gateway-bl0d02si.uc.gateway.dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sop-pt-2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sop-pt-2
VITE_FIREBASE_APP_ID=
VITE_INITIAL_ADMIN_EMAIL=dromero@sop-network.com

# API (Cloud Run env — set on the service, not via Vite)
PORT=8080
CORS_ORIGIN=https://sop-pt-2.web.app,https://sop-pt-2.firebaseapp.com
ADMIN_EMAIL_ALLOWLIST=dromero@sop-network.com
GOOGLE_CLOUD_PROJECT=sop-pt-2
