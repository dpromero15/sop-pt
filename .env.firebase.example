# Production / Firebase Hosting + Cloud Run
# Copy to .env.firebase and fill in values.
# Build SPA: npm run build:firebase

# SPA (baked into dist/ at build time)
VITE_API_BASE_URL=https://YOUR_CLOUD_RUN_URL
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sop-pt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sop-pt
VITE_FIREBASE_APP_ID=
VITE_INITIAL_ADMIN_EMAIL=

# API (Cloud Run env — set on the service, not via Vite)
PORT=8080
CORS_ORIGIN=https://sop-pt.web.app,https://sop-pt.firebaseapp.com
ADMIN_EMAIL_ALLOWLIST=
GOOGLE_CLOUD_PROJECT=sop-pt
